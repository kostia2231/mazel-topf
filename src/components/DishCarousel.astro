---
import { Image } from 'astro:assets';
import ForkSpoon from './icons/ForkSpoon.astro';
import Chevron from './icons/Chevron.astro';
import type { ImageMetadata } from 'astro';
import { path, type Language } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Dish {
  name: string;
  description?: string;
  price?: number;
  image: ImageMetadata;
}

interface Props {
  language: Language;
  dishes: Dish[];
}

const { language, dishes } = Astro.props;
const t = ui[language];

const priceFormat = new Intl.NumberFormat(language === 'de' ? 'de-DE' : 'en-GB', {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
---

<div class="relative" data-dish-carousel>
  <ul
    class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto pb-12 md:grid md:grid-cols-3 md:gap-4 md:overflow-visible md:px-[7.5%] md:pb-2"
    data-dish-track
  >
    {dishes.map((dish) => (
      <li class="group relative w-full shrink-0 snap-center md:w-auto">
        <div class="overflow-hidden">
          <Image
            src={dish.image}
            alt={dish.name}
            sizes="(min-width: 768px) 30vw, 100vw"
            loading="eager"
            fetchpriority="low"
            class="aspect-2/3 w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transition-none md:aspect-[420/524]"
          />
        </div>

        <p
          class="caps absolute -bottom-[7.44%] left-1/2 hidden h-[17%] w-[76.19%] -translate-x-1/2 items-center justify-center bg-brick-500 px-4 text-center text-xs text-white md:flex"
        >
          {dish.name}
        </p>

        <div
          class="absolute -bottom-10 right-6 left-6 flex flex-col items-center bg-brick-500 px-5 pt-24 pb-10 text-center text-white md:pointer-events-none md:-bottom-[7.44%] md:left-1/2 md:right-auto md:hidden md:w-[76.19%] md:-translate-x-1/2 md:pt-30 md:pb-7 md:group-focus-within:flex md:group-hover:flex"
        >
          {dish.price !== undefined && (
            <span
              class="absolute top-0 left-1/2 flex size-16 -translate-x-1/2 items-center justify-center rounded-b-full bg-cream-100 font-display text-lg text-brick-500"
            >
              €{priceFormat.format(dish.price)}
            </span>
          )}
          <p class="caps text-sm">{dish.name}</p>
          <ForkSpoon class="my-4 h-5 w-[22px] text-white" />
          {dish.description && (
            <p class="text-sm leading-relaxed text-white/90">{dish.description}</p>
          )}
        </div>

        <a
          href={path('menu', language)}
          class="absolute inset-0"
          aria-label={t.dishes.viewOnMenu(dish.name)}
        ></a>
      </li>
    ))}
  </ul>

  <button
    type="button"
    class="absolute top-0 bottom-12 left-0 z-10 flex cursor-pointer items-center px-2 text-white md:hidden"
    aria-label={t.dishes.previous}
    data-dish-step="-1"
  >
    <Chevron class="size-7 -scale-x-100 drop-shadow-md" />
  </button>
  <button
    type="button"
    class="absolute top-0 right-0 bottom-12 z-10 flex cursor-pointer items-center px-2 text-white md:hidden"
    aria-label={t.dishes.next}
    data-dish-step="1"
  >
    <Chevron class="size-7 drop-shadow-md" />
  </button>
</div>

<script>
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-dish-carousel]')) {
    const track = carousel.querySelector<HTMLElement>('[data-dish-track]');
    if (!track) continue;

    for (const button of carousel.querySelectorAll<HTMLButtonElement>('[data-dish-step]')) {
      button.addEventListener('click', () => {
        track.scrollBy({
          left: Number(button.dataset.dishStep) * track.clientWidth,
          behavior: 'smooth',
        });
      });
    }
  }
</script>
