---
import { ui } from "../i18n/ui";
import type { Language } from "../i18n/config";

interface Variant {
    name: string;
    price: number;
}

interface Dish {
    name: string;
    description?: string;
    price?: number;
    priceText?: string;
    tags: string[];
    variants?: Variant[];
    variantsNote?: string;
}

interface Props {
    language: Language;
    title: string;
    note?: string;
    dishes: Dish[];
}

const { language, title, note, dishes } = Astro.props;
const t = ui[language];

const priceFormat = new Intl.NumberFormat(
    language === "de" ? "de-DE" : "en-GB",
    {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1,
    },
);
const price = (value: number) =>
    language === "de"
        ? `${priceFormat.format(value)} €`
        : `€ ${priceFormat.format(value)}`;
---

<section>
    <h2 class="font-display text-4xl font-semibold">{title}</h2>
    <hr class="mt-4 w-12 border-t-2 border-brick-500" />
    {note && <p class="mt-4 text-sm italic text-ink-600">{note}</p>}

    <ul class="mt-8 space-y-7">
        {
            dishes.map((dish) => (
                <li>
                    <div class="flex items-end gap-3">
                        <h3 class="min-w-0 font-display text-xl font-semibold leading-tight">
                            {dish.name}
                            {dish.tags.includes("vegetarian") && (
                                <span
                                    class="ml-1 inline-flex size-5 items-center justify-center rounded-full bg-cream-100 align-middle font-sans text-[0.625rem] text-ink-600"
                                    title={t.menu.vegetarian}
                                    aria-label={t.menu.vegetarian}
                                >
                                    V
                                </span>
                            )}
                        </h3>
                        {(dish.priceText || dish.price !== undefined) && (
                            <>
                                <span
                                    class="leader-dots"
                                    aria-hidden="true"
                                />
                                <span class="shrink-0 font-display text-xl font-semibold leading-none">
                                    {dish.priceText ?? price(dish.price!)}
                                </span>
                            </>
                        )}
                    </div>
                    {dish.description && (
                        <p class="mt-2 max-w-md text-sm leading-relaxed text-ink-600 italic">
                            {dish.description}
                        </p>
                    )}

                    {dish.variants && dish.variants.length > 0 && (
                        <div class="mt-3">
                            <p class="text-sm font-semibold">
                                {dish.variantsNote ??
                                    t.menu.addOn}
                            </p>
                            <ul class="mt-1 space-y-1">
                                {dish.variants.map((variant) => (
                                    <li class="flex items-end gap-3 text-sm text-ink-600 italic">
                                        <span class="shrink-0">
                                            {variant.name}
                                        </span>
                                        <span
                                            class="leader-dots mb-1!"
                                            aria-hidden="true"
                                        />
                                        <span class="shrink-0 not-italic">
                                            {price(variant.price)}
                                        </span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )}
                </li>
            ))
        }
    </ul>
    <slot />
</section>
