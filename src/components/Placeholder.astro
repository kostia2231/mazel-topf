---
interface Props {
  ratio?: string;
  label?: string;
  dark?: boolean;
  class?: string;
}

const { ratio, label, dark = false, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'flex items-center justify-center overflow-hidden',
    dark ? 'bg-placeholder-dark' : 'bg-placeholder',
    !ratio && 'w-full',
    className,
  ]}
  style={ratio ? `aspect-ratio: ${ratio}` : undefined}
  aria-hidden="true"
>
  {label && (
    <span class="caps px-4 text-center text-[0.625rem] text-white/80">{label}</span>
  )}
</div>
