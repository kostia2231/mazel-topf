---
import { socialLinks } from '../data/restaurant';
import { iconPaths, iconShift } from '../data/social-icons';

interface Props {
  tone?: 'light' | 'dark' | 'solid';
  class?: string;
}

const { tone = 'light', class: className = '' } = Astro.props;

const styles = {
  light: 'border-white/40 text-white hover:bg-white hover:text-bark-700',
  dark: 'border-line bg-cream-100 text-brick-500 hover:bg-brick-500 hover:text-white',
  solid: 'border-transparent bg-white text-brick-500 hover:bg-brick-500 hover:text-white',
};
const style = styles[tone];
---

<ul class:list={['flex items-center gap-3', className]}>
  {socialLinks.map((link) => (
    <li>
      <a
        href={link.href}
        target="_blank"
        rel="noopener"
        aria-label={link.label}
        class:list={[
          'flex size-9 items-center justify-center rounded-full border',
          style,
        ]}
      >
        <svg viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
          <path d={iconPaths[link.icon]} transform={iconShift[link.icon]} />
        </svg>
      </a>
    </li>
  ))}
</ul>
