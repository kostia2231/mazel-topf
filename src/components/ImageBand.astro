---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<div class="band-frame h-32 sm:h-42 lg:h-88">
  <div class="band-shift h-full w-full">
    <Image
      src={image}
      alt={alt}
      sizes="100vw"
      loading="eager"
      fetchpriority="low"
      class="h-full w-full object-cover"
    />
  </div>
</div>
