---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    name: string;
    poster: ImageMetadata;
    label: string;
    class?: string;
    posterWidth?: number;
    eager?: boolean;
}

const {
    name,
    poster,
    label,
    class: className = "",
    posterWidth = 1520,
    eager = false,
} = Astro.props;

const still = await getImage({
    src: poster,
    width: Math.min(posterWidth, poster.width),
    format: "webp",
});
---

<div class:list={["overflow-hidden", className]}>
    <video
        muted
        loop
        playsinline
        preload={eager ? "metadata" : "none"}
        poster={still.src}
        aria-label={label}
        class="absolute inset-0 h-full w-full object-cover"
        data-background-video
    >
        <source src={`/video/${name}.mp4`} type="video/mp4" />
    </video>
</div>

<script>
    const videos = [
        ...document.querySelectorAll<HTMLVideoElement>("[data-background-video]"),
    ];

    if (videos.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const attempt = (video: HTMLVideoElement) => {
            const playing = video.play();
            if (playing) playing.catch(() => {});
        };

        const start = (video: HTMLVideoElement) => {
            video.muted = true;
            video.preload = "auto";
            video.addEventListener("canplay", () => attempt(video), { once: true });
            video.load();
            attempt(video);
        };

        const revive = () => {
            for (const video of videos) {
                if (video.paused && video.readyState >= 2) attempt(video);
            }
        };

        addEventListener("visibilitychange", () => {
            if (!document.hidden) revive();
        });
        addEventListener("pointerdown", revive, { once: true });

        if (!("IntersectionObserver" in window)) {
            for (const video of videos) start(video);
        } else {
            const watcher = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (!entry.isIntersecting) continue;
                        watcher.unobserve(entry.target);
                        start(entry.target as HTMLVideoElement);
                    }
                },
                { rootMargin: "200px" },
            );

            for (const video of videos) watcher.observe(video);
        }
    }
</script>
