---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    /** Имя файла в public/video без расширения. */
    name: string;
    poster: ImageMetadata;
    label: string;
    /** Классы обёртки: размеры и положение задаёт вызывающая сторона. */
    class?: string;
    posterWidths?: number[];
    /** Постер верхнего экрана грузим сразу, остальные — лениво. */
    eager?: boolean;
}

const {
    name,
    poster,
    label,
    class: className = "",
    posterWidths = [960, 1520],
    eager = false,
} = Astro.props;
---

{/* Постер рисуется сразу и держит кадр. Само видео не скачивается, пока
    блок не подойдёт к экрану, и проявляется поверх постера, когда пошло. */}
<div class:list={["overflow-hidden", className]}>
    <Image
        src={poster}
        alt={label}
        widths={posterWidths}
        width={poster.width}
        sizes="100vw"
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
        class="absolute inset-0 h-full w-full object-cover"
    />

    <video
        muted
        loop
        playsinline
        preload="none"
        aria-label={label}
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-out motion-reduce:transition-none"
        data-background-video
    >
        <source src={`/video/${name}.mp4`} type="video/mp4" />
    </video>
</div>

<script>
    const videos = [
        ...document.querySelectorAll<HTMLVideoElement>("[data-background-video]"),
    ];

    // При запросе на меньше движения ничего не качаем — остаётся постер.
    if (videos.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const start = (video: HTMLVideoElement) => {
            video.addEventListener(
                "playing",
                () => video.classList.remove("opacity-0"),
                { once: true },
            );
            video.preload = "auto";
            video.load();
            video.play().catch(() => {
                // автовоспроизведение запретили — остаётся постер
            });
        };

        if (!("IntersectionObserver" in window)) {
            for (const video of videos) start(video);
        } else {
            const watcher = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (!entry.isIntersecting) continue;
                        watcher.unobserve(entry.target);
                        start(entry.target as HTMLVideoElement);
                    }
                },
                { rootMargin: "200px" },
            );

            for (const video of videos) watcher.observe(video);
        }
    }
</script>
