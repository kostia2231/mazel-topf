---
import { Image } from "astro:assets";
import tableImage from "../assets/laid-table.png";
import { content } from "../i18n/content";
import { ui } from "../i18n/ui";
import { path, type Language } from "../i18n/config";
import Button from "./Button.astro";
import Placeholder from "./Placeholder.astro";

interface Props {
    language: Language;
}

const { language } = Astro.props;
const block = content[language].cateringBlock;
const t = ui[language];
---

<section
    class="mx-auto grid max-w-[1520px] gap-8 px-6 pt-2 pb-12 sm:gap-12 sm:py-16 md:grid-cols-2 lg:gap-20 lg:px-[7.5%] lg:py-24"
>
    <div>
        <p class="uppercase tracking-wider text-xs text-ink-400">
            {block.eyebrow}
        </p>
        <h2
            class="mt-5 font-display text-2xl leading-[1.15] font-semibold sm:text-4xl lg:text-[2.75rem]"
        >
            {block.title}
        </h2>
        <hr class="mt-6 w-12 border-t-2 border-brick-500" />
        <div class="mt-8 space-y-5 text-sm leading-relaxed text-ink-600">
            {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <ul class="mt-10 space-y-5">
            {
                block.points.map((point, i) => (
                    <li>
                        <h3>
                            <button
                                type="button"
                                data-accordion
                                aria-expanded={i === 1 ? "true" : "false"}
                                class="flex w-full gap-4 text-left cursor-pointer items-center hover:text-brick-500"
                            >
                                <span
                                    class="w-4 shrink-0 text-lg leading-none text-brick-500"
                                    aria-hidden="true"
                                >
                                    {i === 1 ? "–" : "+"}
                                </span>
                                <span class="font-display text-2xl leading-tight font-semibold">
                                    {point.title}
                                </span>
                            </button>
                        </h3>
                        <p
                            hidden={i !== 1}
                            class="mt-2 pl-8 text-sm leading-relaxed text-ink-400"
                        >
                            {point.text}
                        </p>
                    </li>
                ))
            }
        </ul>
        <Button
            href={path("contact", language)}
            class="mt-8 w-full sm:mt-10 sm:w-auto">{block.cta}</Button
        >
    </div>
    <div class="-order-1 -mx-6 sm:mx-0 md:order-none">
        <div class="group overflow-hidden">
            <Image
                src={tableImage}
                alt={t.images.laidTable}
                class="aspect-[666/651] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transition-none"
            />
        </div>
        <ul class="grid grid-cols-11 sm:grid-cols-2">
            {
                block.stats.map((stat, i) => (
                    <li
                        class:list={[
                            "p-6 text-white sm:col-span-1",
                            i === 0 ? "col-span-4" : "col-span-7",
                            stat.color === "brick"
                                ? "bg-brick-500"
                                : "bg-navy-700",
                        ]}
                    >
                        <p class="font-display font-semibold text-3xl leading-none">
                            {stat.value}
                        </p>
                        <p class="caps mt-3 text-[0.6875rem] leading-relaxed text-white/85">
                            {stat.text}
                        </p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
<script>
    document
        .querySelectorAll<HTMLButtonElement>("[data-accordion]")
        .forEach((button) => {
            button.addEventListener("click", () => {
                const text = button.closest("li")?.querySelector("p");
                const sign = button.querySelector("span");
                if (!text || !sign) return;
                const isOpen = !text.hidden;
                text.hidden = isOpen;
                sign.textContent = isOpen ? "+" : "–";
                button.setAttribute("aria-expanded", String(!isOpen));
            });
        });
</script>
