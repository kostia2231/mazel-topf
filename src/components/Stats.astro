---
interface Props {
    items: readonly { value: string; text: string }[];
    class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<ul
    class:list={[
        "grid gap-10 text-center sm:grid-cols-2 lg:grid-cols-4",
        className,
    ]}
>
    {
        items.map((item) => (
            <li>
                <p class="font-display font-bold text-4xl leading-none">
                    {item.value}
                </p>
                <p class="uppercase tracking-wider font-semibold mx-auto mt-3 max-w-xs text-xs">
                    {item.text}
                </p>
            </li>
        ))
    }
</ul>
