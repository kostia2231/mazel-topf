---
interface Props {
    href?: string;
    type?: "button" | "submit";
    variant?: "brick" | "white" | "red" | "none";
    class?: string;
}

const {
    href,
    type = "button",
    variant = "brick",
    class: className = "",
} = Astro.props;

const variants = {
    brick: "border-brick-500 text-brick-500 hover:bg-brick-500 hover:text-white",
    white: "border-white/70 bg-white/10 text-white hover:bg-white hover:text-ink-900",
    red: "bg-white border-white text-brick-500 hover:bg-brick-500 hover:text-white hover:border-brick-500",
    none: "",
};

const label = await Astro.slots.render("default");

const Tag = href ? "a" : "button";

const layer =
    "absolute inset-0 flex items-center justify-center transition-transform duration-300 ease-out motion-reduce:transition-none";
---

<Tag
    href={href}
    type={href ? undefined : type}
    class:list={[
        "btn-outline group relative overflow-hidden align-bottom",
        variants[variant],
        className,
    ]}
>
    <span class="invisible block" set:html={label} />
    <span class:list={[layer, "group-hover:-translate-y-full"]} set:html={label} />
    <span
        class:list={[layer, "translate-y-full group-hover:translate-y-0"]}
        aria-hidden="true"
        set:html={label}
    />
</Tag>
