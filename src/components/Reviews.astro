---
import Chevron from "./icons/Chevron.astro";
import { content } from "../i18n/content";
import { ui } from "../i18n/ui";
import type { Language } from "../i18n/config";

interface Props {
    language: Language;
    variant?: "center" | "image";
}

const { language, variant = "center" } = Astro.props;
const t = ui[language];
const reviews = content[language].reviews;
---

<div
    class:list={[
        "relative w-full min-w-0",
        variant === "center"
            ? "mx-auto max-w-[1520px] text-center"
            : "px-6 lg:px-14",
    ]}
    data-reviews
>
    <div class:list={[variant === "center" && "mx-auto max-w-3xl px-14"]}>
        <svg
            viewBox="0 0 24 24"
            class:list={[
                "size-7 fill-brick-500",
                variant === "center" && "mx-auto",
            ]}
            aria-hidden="true"
        >
            <path d="M4 14c0-4 2-7 6-8v3c-2 .7-3 2-3 3h3v6H4v-4Zm10 0c0-4 2-7 6-8v3c-2 .7-3 2-3 3h3v6h-6v-4Z"></path>
        </svg>

        <ul
            class="no-scrollbar mt-8 flex snap-x snap-mandatory overflow-x-auto"
            data-reviews-track
        >
            {reviews.map((review) => (
                <li class="w-full shrink-0 snap-center">
                    <h3 class="caps font-display font-semibold text-lg">
                        {review.title}
                    </h3>
                    <p class="mt-6 font-display text-lg leading-relaxed text-ink-900 italic">
                        {review.text}
                    </p>
                    <p
                        class="mt-6 tracking-[0.2em] text-brick-500"
                        aria-label={t.reviews.stars(review.stars)}
                    >
                        {"★".repeat(review.stars)}
                    </p>
                    <p class="caps mt-3 text-xs text-ink-400">
                        {review.author}
                    </p>
                </li>
            ))}
        </ul>
    </div>

    {variant === "image" ? (
        <div class="mt-8 flex gap-3">
            {reviews.map((_, i) => (
                <button
                    type="button"
                    data-goto={i}
                    aria-label={t.reviews.show(i + 1)}
                    class="size-3 cursor-pointer rounded-full border border-brick-500 transition-colors aria-[current=true]:bg-brick-500 not-aria-[current=true]:border-transparent not-aria-[current=true]:bg-ink-400/40"
                    aria-current={i === 0 ? "true" : "false"}
                />
            ))}
        </div>
    ) : (
        <>
            <button
                type="button"
                data-step="-1"
                aria-label={t.reviews.previous}
                class="absolute cursor-pointer top-1/2 left-2 -translate-y-1/2 p-3 text-ink-400 transition-colors hover:text-brick-500 sm:left-6 lg:left-[51px]"
            >
                <Chevron class="size-6 -scale-x-100" />
            </button>
            <button
                type="button"
                data-step="1"
                aria-label={t.reviews.next}
                class="absolute cursor-pointer top-1/2 right-2 -translate-y-1/2 p-3 text-ink-400 transition-colors hover:text-brick-500 sm:right-6 lg:right-[51px]"
            >
                <Chevron class="size-6" />
            </button>
        </>
    )}
</div>

<script>
    for (const root of document.querySelectorAll<HTMLElement>(
        "[data-reviews]",
    )) {
        const track = root.querySelector<HTMLElement>("[data-reviews-track]");
        if (!track) continue;

        const dots = [
            ...root.querySelectorAll<HTMLButtonElement>("[data-goto]"),
        ];

        const goTo = (index: number) => {
            const count = track.children.length;
            const target = ((index % count) + count) % count;
            track.scrollTo({
                left: target * track.clientWidth,
                behavior: "smooth",
            });
        };

        const current = () => Math.round(track.scrollLeft / track.clientWidth);

        for (const dot of dots) {
            dot.addEventListener("click", () => goTo(Number(dot.dataset.goto)));
        }

        for (const button of root.querySelectorAll<HTMLButtonElement>(
            "[data-step]",
        )) {
            button.addEventListener("click", () =>
                goTo(current() + Number(button.dataset.step)),
            );
        }

        let queued = false;
        track.addEventListener(
            "scroll",
            () => {
                if (queued) return;
                queued = true;
                requestAnimationFrame(() => {
                    queued = false;
                    const active = current();
                    dots.forEach((dot, i) =>
                        dot.setAttribute("aria-current", String(i === active)),
                    );
                });
            },
            { passive: true },
        );
    }
</script>
