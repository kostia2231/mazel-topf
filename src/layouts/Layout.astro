---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import StructuredData from '../components/StructuredData.astro';
import { restaurant } from '../data/restaurant';
import { isCanonicalHost } from '../data/seo';
import { formEndpoint, honeypot } from '../data/forms';
import { content } from '../i18n/content';
import { ui } from '../i18n/ui';
import {
  path,
  languages,
  defaultLanguage,
  type RouteKey,
  type Language,
} from '../i18n/config';

interface Props {
  language: Language;
  page: RouteKey;
  title: string;
  description?: string;
}

const { language, page, title, description = content[language].description } = Astro.props;
const t = ui[language];

const documentTitle = `${title} · ${restaurant.name}`;

const indexable = isCanonicalHost(Astro.site);

const absoluteUrl = (s: Language) =>
  Astro.site ? new URL(path(page, s), Astro.site).href : undefined;
const canonical = absoluteUrl(language);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={language === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:site_name" content={restaurant.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && (
      <>
        <meta property="og:image" content={new URL('/og.jpg', Astro.site).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ui[language].images.hero} />
      </>
    )}
    {canonical && <link rel="canonical" href={canonical} />}

    {Astro.site &&
      languages.map((s) => <link rel="alternate" hreflang={s} href={absoluteUrl(s)} />)}
    {Astro.site && (
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(defaultLanguage)} />
    )}

    <script is:inline>
      document.documentElement.classList.add("reveal-ready");
    </script>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <StructuredData language={language} />
    <Font cssVariable="--font-cormorant-infant" preload />
    <Font cssVariable="--font-nunito" preload />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header language={language} page={page} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer language={language} />
    <CookieBanner language={language} />
  </body>
</html>

<script>
  const items = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];

  if (!("IntersectionObserver" in window)) {
    for (const item of items) item.classList.add("is-revealed");
  } else {
    const watcher = new IntersectionObserver(
      (entries) => {
        const arriving = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        arriving.forEach((entry, index) => {
          const element = entry.target as HTMLElement;
          element.style.transitionDelay = `${Math.min(index, 4) * 90}ms`;
          element.classList.add("is-revealed");
          watcher.unobserve(element);
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
    );

    for (const item of items) watcher.observe(item);
  }

  for (const image of document.querySelectorAll<HTMLImageElement>("main img")) {
    const done = () => image.classList.add("is-loaded");
    if (image.complete) done();
    else {
      image.addEventListener("load", done, { once: true });
      image.addEventListener("error", done, { once: true });
    }
  }
</script>

<script define:vars={{ endpoint: formEndpoint, honeypot }}>
  window.__mazelForms = { endpoint, honeypot };
</script>

<script>
  // Общая отправка для всех форм сайта. Сайт статический и может стоять где
  // угодно, поэтому шлём JSON на внешний обработчик из PUBLIC_FORM_ENDPOINT,
  // а форму на месте подменяем блоком благодарности.
  const { endpoint, honeypot } = window.__mazelForms ?? {};

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-form] form")) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const scope = form.closest<HTMLElement>("[data-form]");
      const body = scope?.querySelector<HTMLElement>("[data-form-body]");
      const success = scope?.querySelector<HTMLElement>("[data-form-success]");
      const error = scope?.querySelector<HTMLElement>("[data-form-error]");
      const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");

      const showSuccess = () => {
        form.reset();
        body?.classList.add("hidden");
        success?.classList.remove("hidden");
        const focusTarget = success?.matches("[data-form-focus]")
          ? success
          : success?.querySelector<HTMLElement>("[data-form-focus]");
        focusTarget?.focus();
      };

      const fields = Object.fromEntries(new FormData(form)) as Record<string, string>;

      // Ловушку заполняют только боты. Показываем им благодарность и молчим.
      if (honeypot && fields[honeypot]) return showSuccess();
      if (honeypot) delete fields[honeypot];

      if (!endpoint) {
        console.error(
          "PUBLIC_FORM_ENDPOINT не задан — форму отправлять некуда.",
        );
        error?.classList.remove("hidden");
        return;
      }

      error?.classList.add("hidden");
      if (submit) submit.disabled = true;

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({
            form: form.getAttribute("name"),
            page: location.href,
            ...fields,
          }),
        });

        if (!response.ok) throw new Error(String(response.status));
        showSuccess();
      } catch {
        error?.classList.remove("hidden");
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
